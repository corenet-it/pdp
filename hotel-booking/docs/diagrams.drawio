        <mxCell id="title" value="&lt;b&gt;P05 · Hotel business contexts&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=15;fillColor=none;strokeColor=none;spacing=0;fontSize=28;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Arrows represent questions, commands and replies. Solid = current interaction; dashed = planned / not wired.&lt;br&gt;Message fields and exact P06 status: docs/contexts.md → Between contexts." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=15;fillColor=none;strokeColor=none;spacing=0;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1320" height="60" as="geometry" />
