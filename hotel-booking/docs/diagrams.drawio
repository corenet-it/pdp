          <mxGeometry x="520" y="330" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="payments" value="&lt;b&gt;Payments&lt;/b&gt;&lt;br&gt;&lt;br&gt;Deposit policy · Payment outcome&lt;br&gt;Paid / Declined&lt;br&gt;&lt;br&gt;Contract + simulation only in P06." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1020" y="170" width="300" height="190" as="geometry" />
        </mxCell>
