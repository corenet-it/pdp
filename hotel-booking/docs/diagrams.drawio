  <diagram id="modules" name="Modules">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;P06 · One application, four modules&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=15;fillColor=none;strokeColor=none;spacing=0;fontSize=28;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Solid arrows show current imports. Only main.py and tests select another module’s internal adapters." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=15;fillColor=none;strokeColor=none;spacing=0;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="wiring" value="&lt;b&gt;main.py · composition root&lt;/b&gt;&lt;br&gt;InMemoryRoomCatalog → list[Room]&lt;br&gt;InMemoryReservationStore + EmailNotificationSender → BookingService" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=15;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="420" y="160" width="560" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rooms" value="&lt;b&gt;Rooms · hotel_booking.rooms&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Public&lt;/b&gt;&lt;br&gt;Room · RoomCatalog&lt;br&gt;&lt;br&gt;&lt;b&gt;Internal&lt;/b&gt;&lt;br&gt;InMemoryRoomCatalog" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="350" height="250" as="geometry" />
        </mxCell>
        <mxCell id="reservations" value="&lt;b&gt;Reservations · hotel_booking.reservations&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Public&lt;/b&gt;&lt;br&gt;BookingService · BookingResult&lt;br&gt;Reservation · ReservationStatus&lt;br&gt;DateRange · Guest · ReservationStore&lt;br&gt;&lt;br&gt;&lt;b&gt;Internal&lt;/b&gt;&lt;br&gt;InMemoryReservationStore" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="520" y="430" width="420" height="300" as="geometry" />
        </mxCell>
        <mxCell id="notifications" value="&lt;b&gt;Notifications&lt;/b&gt;&lt;br&gt;hotel_booking.notifications&lt;br&gt;&lt;br&gt;&lt;b&gt;Public&lt;/b&gt;&lt;br&gt;Confirmation · NotificationSender&lt;br&gt;&lt;br&gt;&lt;b&gt;Internal&lt;/b&gt;&lt;br&gt;EmailNotificationSender&lt;br&gt;SmsNotificationSender" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=15;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1050" y="430" width="310" height="300" as="geometry" />
        </mxCell>
        <mxCell id="payments" value="&lt;b&gt;Payments · hotel_booking.payments&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Public:&lt;/b&gt; PaymentStatus · PaymentService&lt;br&gt;&lt;b&gt;Internal:&lt;/b&gt; SimulatedPaymentService&lt;br&gt;&lt;br&gt;No booking call/import yet; integration reserved for P17." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="520" y="810" width="420" height="210" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="catalogue adapter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#44546a;exitX=0.1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="wiring" target="rooms">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="476" y="350" />
              <mxPoint x="215" y="350" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="w2" value="service + store adapter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#44546a;exitX=0.55;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="wiring" target="reservations">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="email adapter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#44546a;exitX=0.9;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="wiring" target="notifications">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="924" y="350" />
              <mxPoint x="1205" y="350" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m1" value="Room&#10;(public)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#44546a;exitX=0;exitY=0.4;entryX=1;entryY=0.48;" edge="1" parent="1" source="reservations" target="rooms">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="Confirmation&#10;NotificationSender" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#44546a;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="reservations" target="notifications">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="checks" value="&lt;b&gt;Three architecture checks&lt;/b&gt;&lt;br&gt;1. No cross-module internal imports.&lt;br&gt;2. Rooms imports no other module.&lt;br&gt;3. Payments / Notifications do not import Reservations.&lt;br&gt;&lt;br&gt;Run: lint-imports --no-cache" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=15;fillColor=#f5f5f5;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="40" y="810" width="420" height="210" as="geometry" />
        </mxCell>
        <mxCell id="behaviour" value="&lt;b&gt;Behaviour retained&lt;/b&gt;&lt;br&gt;8 tests · 9 demo lines&lt;br&gt;Race still double-books (P09).&lt;br&gt;&lt;br&gt;Confirmation carries five values;&lt;br&gt;Notifications never imports Reservation." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=15;fillColor=#f5f5f5;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="1000" y="810" width="360" height="210" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
